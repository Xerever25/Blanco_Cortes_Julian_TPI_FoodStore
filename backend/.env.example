# Copiar este archivo a .env y ajustar los valores. NO subir ni entregar el .env.

# Conexión a la base. PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db
# Para desarrollo local sin PostgreSQL se puede usar SQLite:
# DATABASE_URL=sqlite:///./foodstore.db

# Firma del JWT (mínimo 32 caracteres). Generar una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173

# Cookie HttpOnly del JWT: en producción con HTTPS usar COOKIE_SECURE=true
COOKIE_SECURE=false
